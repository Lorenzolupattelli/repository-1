# ==========================================================================
# Credenziali Meta Marketing API
# --------------------------------------------------------------------------
# 1. Copia questo file:   cp .env.example .env
# 2. Inserisci i tuoi valori reali in .env
# 3. NON committare mai .env (è già ignorato in .gitignore)
# ==========================================================================

# Access token (System User token consigliato per l'automazione).
# Generato da business.facebook.com o dal Graph API Explorer.
META_ACCESS_TOKEN=

# ID dell'ad account, con o senza il prefisso "act_".
# Esempio: act_1234567890  oppure  1234567890
META_AD_ACCOUNT_ID=

# App ID e App Secret dell'app su developers.facebook.com.
# Opzionali per le chiamate base, consigliati per token a lunga durata.
META_APP_ID=
META_APP_SECRET=

# Versione dell'API Graph da usare (opzionale, default nel codice).
META_API_VERSION=v21.0

# ==========================================================================
# Credenziali Shopify Admin API (per la pipeline P&L)
# --------------------------------------------------------------------------
# Dominio *.myshopify.com dello store (es. ep1ukb-rg.myshopify.com).
SHOPIFY_STORE_DOMAIN=

# Admin API access token (shpat_...). Da: Shopify Admin -> Impostazioni ->
# App e canali di vendita -> Sviluppa app -> crea app -> Admin API token.
# Scope necessario: read_orders (e read_products).
SHOPIFY_ADMIN_TOKEN=

# Versione API (opzionale, default 2025-01).
SHOPIFY_API_VERSION=2025-01
